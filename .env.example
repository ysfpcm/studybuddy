# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=sk-...

# Voice layer (full-duplex speech) and the brain it delegates to
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
TTS_VOICE=marin
BRAIN_MODEL=gpt-6-luna
# none | low | medium | high  (low keeps voice replies snappy)
BRAIN_REASONING_EFFORT=low

# responses = GPT-Live calls Luna directly (default, lowest latency)
# client    = fallback if you get "model_not_found"/403 on delegation: this app calls Luna itself
DELEGATION_MODE=responses

# Hard stop so a forgotten session doesn't keep billing (~$0.05/min voice)
MAX_SESSION_MINUTES=45

# Where course folders live. Can point elsewhere, e.g. C:\Users\YourName\Documents\schoolwork
COURSES_DIR=courses
DATA_DIR=data
PORT=8765

# ---- Credits / cost control ----
# Premium voice is paused once this month's spend hits the budget (Economy voice + Text keep working)
MONTHLY_BUDGET=25
# End a premium voice session after this many seconds of silence (you can Resume)
IDLE_END_SECONDS=180
# Prices in USD (update if OpenAI changes pricing)
PRICE_LIVE_PER_MIN=0.05
# Estimate used in receipts for Economy TTS (the speech API returns audio, not token usage)
PRICE_TTS_EST_PER_MIN=0.015
PRICE_BRAIN_IN_PER_M=0.20
PRICE_BRAIN_CACHED_PER_M=0.02
PRICE_BRAIN_OUT_PER_M=1.00

# ---- Eyes (screen sharing) ----
# openai = Luna describes the screenshot (~$0.0001/look) · ollama = free local vision model
VISION_PROVIDER=openai
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
